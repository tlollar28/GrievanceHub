# Non-secret browser API base URL. In development, Vite proxies /api → FastAPI.
VITE_API_BASE_URL=/api

# Optional: override the Vite development proxy target (Vite config only; not a browser secret).
# DEV_API_TARGET=http://127.0.0.1:8000

# Do not put GRIEVANCEHUB_API_KEY, GRIEVANCEHUB_ADMIN_API_KEY, OpenAI keys,
# database URLs, or other secrets in frontend environment variables.
